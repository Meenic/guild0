{
  "name": "guild0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "start:web": "pnpm --filter web start",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @guild0/db db:generate",
    "db:migrate": "pnpm --filter @guild0/db db:migrate",
    "db:push": "pnpm --filter @guild0/db db:push",
    "db:studio": "pnpm --filter @guild0/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  }
}
